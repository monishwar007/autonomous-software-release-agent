# Copy this file to .env and fill in real values.
# The app works in demo mode with all of these left blank.

# Groq API key (get one free at https://console.groq.com/keys)
# Despite the variable name, this is a Groq key (starts with gsk_), not an OpenAI key.
OPENAI_API_KEY=

# Groq model to use for release evaluation
GROQ_MODEL=llama-3.3-70b-versatile

# GitHub personal access token (classic PAT with "repo" scope, or a
# fine-grained token with read access to the repos you want to analyze).
# Needed for private repos and to avoid GitHub's low unauthenticated
# rate limit (60 requests/hour vs 5000/hour with a token).
GITHUB_TOKEN=

# Default repo to analyze when none is specified in a request, e.g. owner/repo
GITHUB_REPO=

# Shared secret for verifying GitHub webhook signatures. Set this to the
# same value you configure in GitHub's webhook settings (repo Settings ->
# Webhooks -> Secret). Without this, /webhook/github will still work but
# without signature verification -- fine for local testing, not for a
# publicly reachable deployment.
WEBHOOK_SECRET=

SECRET_KEY=change-me-to-something-random
